# Image de l'API chatbot Kiyanza (fonctionnalité 4.1.A "Poser une question").
#
# PostgreSQL reste hors du conteneur. La base vectorielle Chroma
# (output/chroma_db) est ici COPIÉE dans l'image (et non montée en volume) :
# c'est le choix le plus simple pour un premier déploiement sur Render, qui
# n'a pas d'équivalent gratuit à un volume Docker local. Contrepartie : toute
# mise à jour de la base de connaissances nécessite de reconstruire l'image
# (un simple git push suffit si le déploiement est connecté au dépôt).

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-chatbot.txt .
RUN pip install --no-cache-dir -r requirements-chatbot.txt

COPY run_chatbot_api.py .
COPY scripts/chatbot/chatbot.py ./scripts/chatbot/chatbot.py
COPY scripts/chatbot/chatbot_api.py ./scripts/chatbot/chatbot_api.py
COPY scripts/chatbot/rag_retrieve.py ./scripts/chatbot/rag_retrieve.py
COPY scripts/chatbot/text_to_sql.py ./scripts/chatbot/text_to_sql.py
COPY scripts/chatbot/llm_client.py ./scripts/chatbot/llm_client.py
COPY scripts/chatbot/system_prompt.md ./scripts/chatbot/system_prompt.md
COPY output/chroma_db/ ./output/chroma_db/

EXPOSE 8000

ENV API_RELOAD=false

CMD ["python", "run_chatbot_api.py"]

# Garde le contexte envoyé au démon Docker léger et rapide, même si les
# Dockerfiles ne font que des COPY sélectifs.

venv/
__pycache__/
*.pyc
.git/
.env
mlflow.db
*.xlsx
*.csv

# Sous-dossiers générés/de test du monitoring radio : pas du code source,
# inutiles dans l'image (et parfois volumineux — fichiers audio).
scripts/radio_monitoring/test_audio/
scripts/radio_monitoring/captures/
scripts/radio_monitoring/reports/
scripts/radio_monitoring/uploaded_spots/
scripts/radio_monitoring/__pycache__/

scripts/chatbot/__pycache__/
scripts/simulation/__pycache__/

# On garde volontairement data/simulation/ et models/simulation/ (nécessaires

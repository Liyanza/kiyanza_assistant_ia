# Garde le contexte envoyé au démon Docker léger et rapide, même si le
# Dockerfile ne fait que des COPY sélectifs (le contexte entier est quand
# même lu/compressé avant l'envoi).

venv/
__pycache__/
*.pyc
.git/
.env
mlflow.db
chroma_db/
*.xlsx
*.csv
data/simulation/*.pkl.bak
scripts/chatbot/__pycache__/
scripts/simulation/__pycache__/

# On garde volontairement data/simulation/ et models/simulation/ (nécessaires
# au build), donc pas de règle générale excluant data/ ou models/ ici.

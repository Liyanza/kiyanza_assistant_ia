# Copie ce fichier en ".env" et remplis-le. Ne JAMAIS commiter le .env.

# --- Commun ----------------------------------------------------------------
# Clé Gemini gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Secret partagé avec Liyanza-backend (header X-Internal-Token), au moins
# 32 caractères : openssl rand -hex 32
# Doit être IDENTIQUE à IA_SERVICE_INTERNAL_TOKEN côté backend.
INTERNAL_TOKEN=

# --- Développement local (python run_chatbot_api.py / docker-compose.yml) --
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kiyanza
DB_USER=postgres
DB_PASSWORD=ton_mot_de_passe

# --- Déploiement AWS (docker-compose.aws.yml, voir deploy/aws/README.md) ---
# Nom de domaine public servi en HTTPS par Caddy. Sans domaine à toi :
# <IP publique avec des tirets>.sslip.io, ex: 13-37-1-2.sslip.io
PUBLIC_HOST=
# Mots de passe PostgreSQL (générer avec : openssl rand -hex 16)
DB_ADMIN_PASSWORD=
DB_READONLY_PASSWORD=
